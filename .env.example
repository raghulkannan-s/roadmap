# ===================================================================
# 1. Google Gemini AI API Key (Required for AI generation)
# Get a free key at: https://aistudio.google.com/apikey
# ===================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ===================================================================
# 2. Database Connection URL (PostgreSQL / Neon Serverless Postgres)
# - For Local Postgres: postgresql://postgres:password@localhost:5432/roadmap
# - For Neon Serverless: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# ===================================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/roadmap"

# ===================================================================
# 3. Auth.js / NextAuth Secret
# Generate with: npx auth secret (or any random 32-char string)
# ===================================================================
AUTH_SECRET="your_random_32_character_secret_here"
# Use the URL where the browser opens the app. For LAN testing:
# AUTH_URL="http://192.168.1.36:3000"
AUTH_URL="http://localhost:3000"

# ===================================================================
# 4. Google OAuth 2.0 Credentials (for Sign in with Google)
# Create in Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI in Google Cloud Console:
# http://localhost:3000/api/auth/callback/google
# For LAN testing, also add:
# http://192.168.1.36:3000/api/auth/callback/google
# ===================================================================
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-client-secret"
